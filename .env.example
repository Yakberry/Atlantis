# Скопируйте в .env (для локального запуска) или задайте переменными окружения на хостинге. Все значения необязательны.

# --- сервер ---
PORT=3000
HOST=0.0.0.0
# NODE_ENV=production        # на хостинге
LOG_LEVEL=info               # debug | info | warn | error

# --- база данных ---
DATABASE_URL=postgres://atlantis:atlantis@localhost:5432/atlantis
# DATABASE_SSL=false         # false | true | no-verify (для управляемых баз с TLS)
# PG_POOL_MAX=10             # не больше лимита соединений вашего тарифа базы

# --- сеть ---
# TRUST_PROXY=true           # за обратным прокси хостинга (по умолчанию включено в production)
# CORS_ORIGIN=https://game.example.com   # только если клиент и сервер на разных доменах (через запятую)
# CLIENT_DIR=../client/dist  # куда собран клиент (его раздаёт этот же процесс)

# --- ёмкость и защита ---
# MAX_ROOMS=60               # потолок числа комнат
# MAX_CONNECTIONS=400        # потолок одновременных соединений
# SOCKET_EVENTS_PER_SEC=15   # лимит событий в секунду на одно соединение
# SESSIONS_PER_HOUR_PER_IP=30  # новых игроков в час с одного адреса
# ROOM_TTL_HOURS=72          # через сколько часов без действий комната удаляется
